# WebSocket URL for backend connection
# Local development (separate backend/frontend): ws://localhost:8765/ws
# Pi development (served from backend): ws://localhost:8765/ws or ws://<pi-ip>:8765/ws
# Production: ws://localhost:8765/ws (when served from same origin, will use relative path)
VITE_WS_URL=ws://localhost:8765/ws

# Sonos speaker name (must match exactly)
VITE_SONOS_SPEAKER_NAME=Bedroom
