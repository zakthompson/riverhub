# WebSocket server port
WS_PORT=8765

# RFID mode: "real" for RC522 hardware, "mock" for testing without hardware
RFID_MODE=mock

# RFID polling interval in seconds
RFID_POLL_INTERVAL=0.5

# RFID debounce seconds - ignore duplicate reads within this time
RFID_DEBOUNCE_SECONDS=2.0

# Serve static files (set to "true" for production on Pi)
SERVE_STATIC=false

# Static files directory (relative to backend directory)
STATIC_DIR=../frontend/dist

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
