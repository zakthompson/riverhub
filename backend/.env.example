# Server Configuration
PORT=8765
NODE_ENV=development
STATIC_FILES=../frontend/dist

# RFID Configuration
RFID_MODE=mock
RFID_POLL_INTERVAL=0.5
RFID_DEBOUNCE_SECONDS=2.0

# Sonos Configuration
SONOS_SPEAKER_NAME=Bedroom

# Card Mappings
CARD_MAPPINGS_FILE=card-mappings.json

# Logging
LOG_LEVEL=info
